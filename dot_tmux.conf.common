# vim: ft=tmux

# prefix
set -g prefix2 C-a
bind C-a send-prefix -2

set -g default-terminal "tmux-256color"
set -g default-shell /usr/bin/fish
set -g history-limit 50000
set -g extended-keys on
# extended-keys-format is a tmux 3.5+ option; setting it on 3.4 (Ubuntu 24.04)
# fails with "invalid option" while loading the config.
if-shell -F '#{>=:#{version},3.5}' 'set -g extended-keys-format csi-u'

bind v split-window -h -c "#{pane_current_path}"
bind b split-window -c "#{pane_current_path}"
bind e new-window -n '~/.tmux.conf' "sh -c '\${EDITOR:-vim} ~/.tmux.conf && tmux source ~/.tmux.conf && tmux display \"~/.tmux.conf sourced\"'"
bind r source-file ~/.tmux.conf \; display '~/.tmux.conf sourced'
bind C-s set-window-option synchronize-panes

bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R
bind > swap-pane -D
bind < swap-pane -U

bind -r H resize-pane -L 2
bind -r J resize-pane -D 2
bind -r K resize-pane -U 2
bind -r L resize-pane -R 2

# display
set -g status on
set -g base-index 1
set -g renumber-windows on
set -g set-titles on
set -g set-titles-string '#S ● #I #W@#h'
set -g display-panes-time 800
set -g display-time 1000
set -g status-interval 10
set -g mode-style bg=brightwhite,fg=blue
setw -g pane-base-index 1
setw -g automatic-rename on

# activity
set -g monitor-activity on
set -g visual-activity off

set -s escape-time 0
set -g focus-events on
set -g mouse on

# clipboard & terminal features
# Terminal capabilities: Ms = OSC 52 clipboard, Smulx = styled underlines.
# One `set -g` rather than `set -as`: appending would add a duplicate entry on
# every `source-file` (reload), and the defaults for this option are empty.
#
# tmux only emits OSC 52 if the OUTER terminal's terminfo has an Ms entry.
# Ubuntu's xterm-256color and xterm-kitty do not, so without this override a
# copy is silently dropped - locally, and over ssh/mosh (mosh relays OSC 52
# writes, but only if tmux emits them in the first place).
set -g terminal-overrides ',*:Ms=\E]52;%p1%s;%p2%s\007,*:Smulx=\E[4::%p1%dm'
# "on", not "external": external discards OSC 52 writes from applications such
# as Neovim, which is the only way nvim can reach the local clipboard remotely.
set -s set-clipboard on

# vi copy-paste mode
setw -g mode-keys vi
bind -T copy-mode-vi 'v' send -X begin-selection
# y copies through tmux, which emits OSC 52 (see the Ms override above). This
# replaces tmux-yank: that plugin pipes the selection into xsel/xclip/wl-copy,
# which fails on a headless remote (no $DISPLAY), and it installs error bindings
# when no clipboard utility exists at all (e.g. a minimal Arch container),
# overriding this binding.
bind -T copy-mode-vi 'y' send -X copy-selection-and-cancel
bind -T copy-mode-vi 'MouseDragEnd1Pane' send -X copy-selection-and-cancel

# SSH agent: ~/.ssh/rc maintains a stable symlink so panes keep working when
# the ssh connection that created them goes away. Over mosh the bootstrap ssh
# is already gone when tmux starts, so a stale path is worse than none: use the
# symlink if it exists, keep a live agent, otherwise drop the variable.
# SSH_AUTH_SOCK is deliberately not in update-environment for the same reason
# (attaching from mosh would inject the dead path into the session).
set -g update-environment "SSH_AGENT_PID"
run-shell 'sock="$HOME/.ssh/ssh_auth_sock"; if [ -S "$sock" ]; then tmux setenv -g SSH_AUTH_SOCK "$sock"; elif [ -z "$SSH_AUTH_SOCK" ] || [ ! -S "$SSH_AUTH_SOCK" ]; then tmux setenv -gu SSH_AUTH_SOCK 2>/dev/null || true; fi'
