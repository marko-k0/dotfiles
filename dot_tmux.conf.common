# vim: ft=tmux

# prefix
set -g prefix2 C-a
bind C-a send-prefix -2

set -g default-terminal "tmux-256color"
set -g default-shell /usr/bin/fish
set -g history-limit 50000

bind v split-window -h -c "#{pane_current_path}"
bind b split-window -c "#{pane_current_path}"
bind e new-window -n '~/.tmux.conf' "sh -c '\${EDITOR:-vim} ~/.tmux.conf && tmux source ~/.tmux.conf && tmux display \"~/.tmux.conf sourced\"'"
bind r source-file ~/.tmux.conf \; display '~/.tmux.conf sourced'
bind C-s set-window-option synchronize-panes

bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R
bind > swap-pane -D
bind < swap-pane -U

bind -r H resize-pane -L 2
bind -r J resize-pane -D 2
bind -r K resize-pane -U 2
bind -r L resize-pane -R 2

# display
set -g status on
set -g base-index 1
set -g renumber-windows on
set -g set-titles on
set -g set-titles-string '#S ● #I #W@#h'
set -g display-panes-time 800
set -g display-time 1000
set -g status-interval 10
set -g mode-style bg=brightwhite,fg=blue
setw -g pane-base-index 1
setw -g automatic-rename on

# activity
set -g monitor-activity on
set -g visual-activity off

set -s escape-time 0
set -g focus-events on
set -g mouse on

# clipboard & terminal features
set -s set-clipboard external
set -as terminal-features ',xterm-kitty:clipboard'
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'

# vi copy-paste mode
setw -g mode-keys vi
bind -T copy-mode-vi 'v' send -X begin-selection; bind -T copy-mode-vi 'y' send -X copy-selection
bind-key -T copy-mode-vi y if-shell "test ! -z $KITTY_WINDOW_ID" "send-keys -X copy-pipe 'kitty +kitten clipboard'" "send-keys -X copy-pipe  'pbcopy'"

set -g update-environment "SSH_AUTH_SOCK SSH_AGENT_PID"
setenv -g SSH_AUTH_SOCK $HOME/.ssh/ssh_auth_sock
