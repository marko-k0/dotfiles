#!/bin/bash
# Neovim + NvChad base.
# - Ubuntu/Debian: apt ships an old neovim, so install the official GitHub
#   build into /opt (kept out of apt's way), at the version pinned in
#   .chezmoidata/software.yaml ("latest" tracks upstream).
# - Arch: pacman already installed the current neovim (see packages script).
# - NvChad: cloned on first run; chezmoi later overwrites the custom layer
#   in ~/.config/nvim/lua/custom.
# Skipped on Raspbian (vim-only setup: dot_vimrc is deployed instead).
set -euo pipefail
log() { echo "==> [neovim] $*"; }

# Rendered from .chezmoidata/software.yaml
NEOVIM_VERSION="{{ .software.neovim.version }}"

os_id=""
if [ -r /etc/os-release ]; then
    # shellcheck source=/etc/os-release
    . /etc/os-release
    os_id="${ID:-}"
fi
case "$os_id" in
    *raspbian*) log "Raspbian: vim-only setup (dot_vimrc), skipping"; exit 0 ;;
esac

if command -v apt-get >/dev/null 2>&1; then
    # Map machine arch to the GitHub release asset.
    local_asset=""
    case "$(uname -m)" in
        x86_64)  local_asset="nvim-linux-x86_64" ;;
        aarch64) local_asset="nvim-linux-arm64" ;;
    esac

    want="v${NEOVIM_VERSION#v}"
    have=""
    if command -v nvim >/dev/null 2>&1; then
        have="$(nvim --version | head -1 | awk '{print $2}')"
    fi

    up_to_date=false
    if [ "$NEOVIM_VERSION" = "latest" ]; then
        # Tracking upstream: any reasonably current build will do.
        if printf '%s' "$have" | grep -qE '^v0\.(1[0-9]|[2-9])'; then
            up_to_date=true
        fi
    elif [ "$have" = "$want" ]; then
        up_to_date=true
    fi

    if $up_to_date; then
        log "Neovim already installed: ${have}"
    elif [ -n "$local_asset" ]; then
        if [ "$NEOVIM_VERSION" = "latest" ]; then
            url="https://github.com/neovim/neovim/releases/latest/download/${local_asset}.tar.gz"
        else
            url="https://github.com/neovim/neovim/releases/download/${want}/${local_asset}.tar.gz"
        fi
        log "Installing Neovim ${want} from GitHub (${local_asset})"
        curl -fsSL --retry 3 -o "/tmp/${local_asset}.tar.gz" "$url"
        sudo rm -rf "/opt/${local_asset}"
        sudo tar xzf "/tmp/${local_asset}.tar.gz" -C /opt
        sudo ln -sf "/opt/${local_asset}/bin/nvim" /usr/local/bin/nvim
        rm -f "/tmp/${local_asset}.tar.gz"
        log "Installed: $(nvim --version | head -1)"
    else
        log "No official Neovim build for $(uname -m); skipping (install via distro)"
    fi
fi

if [ -d "$HOME/.config/nvim/lua/core" ]; then
    log "NvChad already present"
else
    # Never silently destroy an existing (non-NvChad) config: move it aside.
    if [ -d "$HOME/.config/nvim" ] && [ -n "$(ls -A "$HOME/.config/nvim" 2>/dev/null)" ]; then
        backup="$HOME/.config/nvim.bak-$(date +%Y%m%d-%H%M%S)"
        log "Existing nvim config is not NvChad; moving it to ${backup}"
        mv "$HOME/.config/nvim" "$backup"
    fi
    log "Cloning NvChad v2.0"
    rm -rf "$HOME/.config/nvim"
    git clone --branch v2.0 --depth 1 \
        https://github.com/NvChad/NvChad "$HOME/.config/nvim"
fi
