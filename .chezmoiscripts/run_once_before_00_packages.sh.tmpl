#!/bin/bash
# System packages via the distro package manager.
# Runs via chezmoi BEFORE dotfiles are written.
#
# The package lists live in .chezmoidata/software.yaml, not here: this file is a
# template, so editing the list changes the rendered script and chezmoi re-runs
# it on the next apply.
#
# - Ubuntu/Debian: apt
# - Arch: pacman
# - Raspbian: same apt path, lighter set (vim instead of nvim, no powerline)
# - direnv: config.fish sources its hook on every startup
#
# Neovim, fzf and other versioned CLIs are NOT here: mise owns those (see
# run_after_05_mise.sh), so no tool appears in both lists.
set -euo pipefail
log() { echo "==> [packages] $*"; }

# Rendered from .chezmoidata/software.yaml
PKGS_DEBIAN="{{ join " " .packages.debian }}"
PKGS_ARCH="{{ join " " .packages.arch }}"
PKGS_RASPBIAN="{{ join " " .packages.raspbian }}"

os_id=""
if [ -r /etc/os-release ]; then
    # shellcheck source=/etc/os-release
    . /etc/os-release
    os_id="${ID:-}"
fi

if command -v apt-get >/dev/null 2>&1; then
    case "$os_id" in
        raspbian|raspios)
            log "Installing system packages (apt, Raspbian set)"
            sudo apt-get update -qq
            # shellcheck disable=SC2086  # rendered package list is a word list
            sudo apt-get install -y $PKGS_RASPBIAN
            ;;
        *)
            log "Installing system packages (apt)"
            sudo apt-get update -qq
            pkgs="$PKGS_DEBIAN"
            if ! apt-cache show kitty-terminfo >/dev/null 2>&1; then
                # kitty-terminfo is not packaged everywhere (e.g. some
                # Debian derivatives): install the rest without it.
                pkgs="${pkgs//kitty-terminfo/}"
            fi
            # shellcheck disable=SC2086  # rendered package list is a word list
            sudo apt-get install -y $pkgs
            ;;
    esac
    # tmux-256color terminfo may be missing on older Debian/Ubuntu/Raspbian
    if ! infocmp tmux-256color >/dev/null 2>&1; then
        sudo apt-get install -y ncurses-term 2>/dev/null || true
    fi
elif command -v pacman >/dev/null 2>&1; then
    log "Installing system packages (pacman)"
    # shellcheck disable=SC2086  # rendered package list is a word list
    sudo pacman -Syu --noconfirm --needed $PKGS_ARCH
else
    echo "ERROR: [packages] unsupported package manager (need apt-get or pacman)" >&2
    exit 1
fi
